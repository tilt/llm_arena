{
  "name": "llm-arena-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "contracts": "node scripts/gen-types.mjs",
    "dev": "vite",
    "build": "npm run contracts && npm run verify:assets && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:isolation": "playwright test isolation.spec.ts",
    "test:claim": "CLAIM_E2E=1 playwright test claim.spec.ts --project=chromium",
    "verify:assets": "node scripts/verify-pyodide-assets.mjs"
  },
  "dependencies": {
    "pyodide": "314.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.3",
    "json-schema-to-typescript": "^16.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
