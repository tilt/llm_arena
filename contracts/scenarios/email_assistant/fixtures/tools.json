[
  {
    "function": {
      "description": "List emails in a folder, newest first (without bodies).",
      "name": "list_emails",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "folder": {
            "default": "inbox",
            "description": "inbox, archive or sent",
            "type": "string"
          },
          "unread_only": {
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "permission": "read",
    "type": "function"
  },
  {
    "function": {
      "description": "Search all folders except trash by text and/or sender.",
      "name": "search_emails",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "default": "",
            "description": "Case-insensitive text matched against subject and body",
            "type": "string"
          },
          "sender": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by (part of) the sender address"
          }
        },
        "type": "object"
      }
    },
    "permission": "read",
    "type": "function"
  },
  {
