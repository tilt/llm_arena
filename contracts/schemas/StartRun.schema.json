{
  "$defs": {
    "ArenaConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "judge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge"
        },
        "max_pairs_per_task": {
          "default": 10,
          "title": "Max Pairs Per Task",
          "type": "integer"
        }
      },
      "title": "ArenaConfig",
      "type": "object"
    },
    "ClaimRef": {
      "additionalProperties": false,
      "description": "Marks a run as a reproduction of a shared claim (see `llm_arena.claims`), so the run view can still post it\nafter a reload. Metadata only: fingerprints and resume keys never read it.",
      "properties": {
        "claim_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Claim Hash",
          "type": "string"
        },
        "declared_names": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "local self-hosted model ('<endpoint or provider>:<model>') -> the name it is compared as, frozen when the run started",
          "maxProperties": 32,
          "title": "Declared Names",
          "type": "object"
        },
        "gist_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{20,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None for a hash-link claim",
          "title": "Gist Id"
        },
        "revision": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "claim_hash"
      ],
      "title": "ClaimRef",
      "type": "object"
    },
    "DecisionConfig": {
      "description": "Control policy of a pipeline config. Without it the agent decides everything inside its own loop.",
      "properties": {
        "control": {
          "default": "policy",
          "description": "policy: the policy picks each next tool, judges completion and gates state-changing actions; gate: the agent loop runs as usual and the policy only gates state-changing actions; review: the agent runs unchanged and the policy only reviews the finished trace",
          "enum": [
            "policy",
            "gate",
            "review"
          ],
          "title": "Control",
          "type": "string"
        },
        "fallback": {
          "anyOf": [
            {
              "enum": [
                "llm",
                "jev",
                "ollaya"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "llm",
          "description": "cascade: stage for uncertain answers (None: no stage)",
          "title": "Fallback"
        },
        "hard_rules": {
          "default": true,
          "description": "cascade: the scenario's rules answer first where they apply",
          "title": "Hard Rules",
          "type": "boolean"
        },
        "jev_model": {
          "default": "jev-latest",
          "title": "Jev Model",
          "type": "string"
        },
        "ollaya_model": {
          "default": "winnow:e4b",
          "description": "decision model served by the local Ollaya app",
          "title": "Ollaya Model",
          "type": "string"
        },
        "policy": {
          "default": "llm",
          "enum": [
            "llm",
            "rules",
            "cascade",
            "jev",
            "ollaya"
          ],
          "title": "Policy",
          "type": "string"
        },
        "primary": {
          "default": "llm",
          "description": "cascade: first stage",
          "enum": [
            "llm",
            "jev",
            "ollaya"
          ],
          "title": "Primary",
          "type": "string"
        },
        "review": {
          "default": true,
          "description": "classify the finished trace (task done? needs human review?)",
          "title": "Review",
          "type": "boolean"
        },
        "threshold": {
          "default": 0.8,
          "description": "cascade: escalate below this confidence",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "thresholds": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "per-question thresholds",
          "title": "Thresholds",
          "type": "object"
        }
      },
      "title": "DecisionConfig",
      "type": "object"
    },
    "ExperimentConfig": {
      "properties": {
        "arena": {
          "$ref": "#/$defs/ArenaConfig"
        },
        "budget_mode": {
          "default": "best_effort",
          "enum": [
            "best_effort",
            "strict"
          ],
          "title": "Budget Mode",
          "type": "string"
        },
        "claim_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set on a run that reproduces a shared claim"
        },
        "configs": {
          "items": {
            "$ref": "#/$defs/PipelineConfig"
          },
          "maxItems": 50,
          "title": "Configs",
          "type": "array"
        },
        "judge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge"
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "max tasks per scenario",
          "title": "Limit"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "stop admitting calls near this best-effort spend limit",
          "title": "Max Cost Usd"
        },
        "max_parallel_trials": {
          "default": 4,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Parallel Trials",
          "type": "integer"
        },
        "models_file": {
          "default": "configs/models.yaml",
          "title": "Models File",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "presets": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelPreset"
          },
          "description": "presets defined in the experiment itself (override the runtime's)",
          "title": "Presets",
          "type": "object"
        },
        "repeats": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Repeats",
          "type": "integer"
        },
        "scenarios": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Scenarios",
          "type": "array"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "split": {
          "default": "all",
          "description": "tasks of this split only (tasks without a split are always included)",
          "enum": [
            "all",
            "dev",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "study": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "replacement study: baseline + one config per swapped role and candidate model"
        },
        "task_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Ids"
        },
        "trial_timeout_s": {
          "default": 900.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Trial Timeout S",
          "type": "number"
        }
      },
      "required": [
        "name",
        "scenarios"
      ],
      "title": "ExperimentConfig",
      "type": "object"
    },
    "ModelPreset": {
      "properties": {
        "decision_service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'ollaya:<model>' or 'jev:<model>': the dedicated decision model, if any",
          "title": "Decision Service"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "step kind -> model reference",
          "propertyNames": {
            "enum": [
              "text",
              "vision",
              "code",
              "agent",
              "decision"
            ]
          },
          "title": "Models",
          "type": "object"
        }
      },
      "required": [
        "label",
        "models"
      ],
      "title": "ModelPreset",
      "type": "object"
    },
    "PipelineConfig": {
      "description": "One contestant: a name, a role → model binding, and pattern parameters.",
      "properties": {
        "compare_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "another configuration of the experiment, its baseline: the report shows the effect of what this one changes against it, on the tasks both ran",
          "title": "Compare To"
        },
        "decisions": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "control policy for scenarios that support one; None: the agent decides"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "pattern params, applied to every scenario that knows the key",
          "title": "Params",
          "type": "object"
        },
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "model preset: roles not bound explicitly run on its model for their kind",
          "title": "Preset"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "role -> model alias or 'provider:model'",
          "title": "Roles",
          "type": "object"
        },
        "scenario_params": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "per-scenario overrides",
          "title": "Scenario Params",
          "type": "object"
        },
        "scenario_roles": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "scenario -> role -> model: per-scenario bindings that override `roles`",
          "title": "Scenario Roles",
          "type": "object"
        },
        "scenarios": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "restrict to these scenarios",
          "title": "Scenarios"
        },
        "study": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyTag"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "marks a configuration that swaps one step's model (or a study's baseline): the report labels its effect by step and candidate model"
        }
      },
      "required": [
        "name"
      ],
      "title": "PipelineConfig",
      "type": "object"
    },
    "StudyConfig": {
      "properties": {
        "baseline": {
          "description": "the preset every configuration starts from (the baseline)",
          "title": "Baseline",
          "type": "string"
        },
        "candidates": {
          "description": "model references (or ollaya:/jev: decision models) to try",
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "decision_control": {
          "default": "gate",
          "description": "how a decision-service candidate controls the agent",
          "enum": [
            "gate",
            "policy",
            "review"
          ],
          "title": "Decision Control",
          "type": "string"
        },
        "roles": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 200,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "roles to swap (default: every role except the decision roles)",
          "title": "Roles"
        }
      },
      "required": [
        "baseline",
        "candidates"
      ],
      "title": "StudyConfig",
      "type": "object"
    },
    "StudyTag": {
      "description": "Marks a configuration generated by a study, so the report can compare it with the baseline.",
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate"
        },
        "kind": {
          "enum": [
            "baseline",
            "swap"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StudyTag",
      "type": "object"
    }
  },
  "properties": {
    "experiment": {
      "$ref": "#/$defs/ExperimentConfig"
    },
    "live": {
      "default": false,
      "title": "Live",
      "type": "boolean"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    }
  },
  "required": [
    "experiment"
  ],
  "title": "StartRun",
  "type": "object"
}
