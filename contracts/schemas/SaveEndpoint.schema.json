{
  "$defs": {
    "Capabilities": {
      "description": "What a model can do; checked before a run so a bad role binding fails fast.",
      "properties": {
        "json_schema": {
          "default": true,
          "title": "Json Schema",
          "type": "boolean"
        },
        "reasoning": {
          "default": false,
          "title": "Reasoning",
          "type": "boolean"
        },
        "tools": {
          "default": true,
          "title": "Tools",
          "type": "boolean"
        },
        "vision": {
          "default": false,
          "title": "Vision",
          "type": "boolean"
        }
      },
      "title": "Capabilities",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An endpoint as the app edits it. The id comes from the path; the key env var is not editable here, so a page\ncannot point an existing key (say OPENAI_API_KEY) at a host of its choosing.",
  "properties": {
    "base_url": {
      "title": "Base Url",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "concurrency": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Concurrency"
    },
    "input_cost_per_mtok": {
      "default": 0.0,
      "minimum": 0,
      "title": "Input Cost Per Mtok",
      "type": "number"
    },
    "key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "optional; held in memory for this session only",
      "title": "Key"
    },
    "output_cost_per_mtok": {
      "default": 0.0,
      "minimum": 0,
      "title": "Output Cost Per Mtok",
      "type": "number"
    },
    "salt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "keep the endpoint's identity (browser mode restores a remembered endpoint with it)",
      "title": "Salt"
    }
  },
  "required": [
    "base_url"
  ],
  "title": "SaveEndpoint",
  "type": "object"
}
