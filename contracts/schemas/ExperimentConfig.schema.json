{
  "$defs": {
    "ArenaConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "judge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge"
        },
        "max_pairs_per_task": {
          "default": 10,
          "title": "Max Pairs Per Task",
          "type": "integer"
        }
      },
      "title": "ArenaConfig",
      "type": "object"
    },
    "DecisionConfig": {
      "description": "Control policy of a pipeline config. Without it the agent decides everything inside its own loop.",
      "properties": {
        "control": {
          "default": "policy",
          "description": "policy: the policy picks each next tool, judges completion and gates state-changing actions; gate: the agent loop runs as usual and the policy only gates state-changing actions; review: the agent runs unchanged and the policy only reviews the finished trace",
          "enum": [
            "policy",
            "gate",
            "review"
          ],
          "title": "Control",
          "type": "string"
        },
        "fallback": {
          "anyOf": [
            {
              "enum": [
                "llm",
                "jev",
                "ollaya"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "llm",
          "description": "cascade: stage for uncertain answers (None: no stage)",
          "title": "Fallback"
        },
        "hard_rules": {
          "default": true,
          "description": "cascade: the scenario's rules answer first where they apply",
          "title": "Hard Rules",
          "type": "boolean"
        },
        "jev_model": {
          "default": "jev-latest",
          "title": "Jev Model",
          "type": "string"
        },
        "ollaya_model": {
          "default": "winnow:e4b",
          "description": "decision model served by the local Ollaya app",
          "title": "Ollaya Model",
          "type": "string"
        },
        "policy": {
          "default": "llm",
          "enum": [
            "llm",
            "rules",
            "cascade",
            "jev",
            "ollaya"
          ],
          "title": "Policy",
          "type": "string"
        },
        "primary": {
          "default": "llm",
          "description": "cascade: first stage",
          "enum": [
            "llm",
            "jev",
            "ollaya"
          ],
          "title": "Primary",
          "type": "string"
        },
        "review": {
          "default": true,
          "description": "classify the finished trace (task done? needs human review?)",
          "title": "Review",
          "type": "boolean"
        },
        "threshold": {
          "default": 0.8,
          "description": "cascade: escalate below this confidence",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "thresholds": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "per-question thresholds",
          "title": "Thresholds",
          "type": "object"
        }
      },
      "title": "DecisionConfig",
      "type": "object"
    },
    "PipelineConfig": {
      "description": "One contestant: a name, a role → model binding, and pattern parameters.",
      "properties": {
        "decisions": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "control policy for scenarios that support one; None: the agent decides"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "pattern params, applied to every scenario that knows the key",
          "title": "Params",
          "type": "object"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "role -> model alias or 'provider:model'",
          "title": "Roles",
          "type": "object"
        },
        "scenario_params": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "per-scenario overrides",
          "title": "Scenario Params",
          "type": "object"
        },
        "scenarios": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "restrict to these scenarios",
          "title": "Scenarios"
        }
      },
      "required": [
        "name",
        "roles"
      ],
      "title": "PipelineConfig",
      "type": "object"
    }
  },
  "properties": {
    "arena": {
      "$ref": "#/$defs/ArenaConfig"
    },
    "configs": {
      "items": {
        "$ref": "#/$defs/PipelineConfig"
      },
      "title": "Configs",
      "type": "array"
    },
    "judge": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Judge"
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "max tasks per scenario",
      "title": "Limit"
    },
    "max_cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "stop the run once model spend reaches this limit",
      "title": "Max Cost Usd"
    },
    "max_parallel_trials": {
      "default": 4,
      "title": "Max Parallel Trials",
      "type": "integer"
    },
    "models_file": {
      "default": "configs/models.yaml",
      "title": "Models File",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "repeats": {
      "default": 1,
      "minimum": 1,
      "title": "Repeats",
      "type": "integer"
    },
    "scenarios": {
      "items": {
        "type": "string"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "split": {
      "default": "all",
      "description": "tasks of this split only (tasks without a split are always included)",
      "enum": [
        "all",
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "task_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Ids"
    },
    "trial_timeout_s": {
      "default": 900.0,
      "title": "Trial Timeout S",
      "type": "number"
    }
  },
  "required": [
    "name",
    "scenarios",
    "configs"
  ],
  "title": "ExperimentConfig",
  "type": "object"
}
