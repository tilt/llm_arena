          "default": null,
          "title": "Error"
        },
        "input": {
          "default": null,
          "title": "Input"
        },
        "kind": {
          "enum": [
            "llm_call",
            "tool_call",
            "code_exec",
            "handoff",
            "plan",
            "critique",
            "step",
            "judge",
            "decision"
