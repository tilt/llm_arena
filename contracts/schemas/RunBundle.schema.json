{
  "$defs": {
    "BundleSummary": {
      "properties": {
        "configs": {
          "items": {
            "$ref": "#/$defs/ConfigSummary"
          },
          "title": "Configs",
          "type": "array"
        },
        "decisions": {
          "description": "control-policy decision quality",
          "items": {
            "$ref": "#/$defs/DecisionSummary"
          },
          "title": "Decisions",
          "type": "array"
        },
        "paired_tests": {
          "items": {
            "$ref": "#/$defs/PairedTest"
          },
          "title": "Paired Tests",
          "type": "array"
        },
        "ratings": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "description": "scope ('overall' or scenario) -> config -> rating",
          "title": "Ratings",
          "type": "object"
        },
        "replacements": {
          "description": "replacement studies: each swapped step against the baseline",
          "items": {
            "$ref": "#/$defs/ReplacementEffect"
          },
          "title": "Replacements",
          "type": "array"
        }
      },
      "required": [
        "configs",
        "paired_tests",
        "ratings"
      ],
      "title": "BundleSummary",
      "type": "object"
    },
    "BundledArtifact": {
      "properties": {
        "data": {
          "description": "base64",
          "title": "Data",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "data"
      ],
      "title": "BundledArtifact",
      "type": "object"
    },
    "CalibrationBin": {
      "properties": {
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "mean_p": {
          "description": "mean predicted P(true)",
          "title": "Mean P",
          "type": "number"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "observed": {
          "description": "share of true labels",
          "title": "Observed",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high",
        "n",
        "mean_p",
        "observed"
      ],
      "title": "CalibrationBin",
      "type": "object"
    },
    "ConfigSummary": {
      "properties": {
        "ci_high": {
          "title": "Ci High",
          "type": "number"
        },
        "ci_low": {
          "title": "Ci Low",
          "type": "number"
        },
        "config": {
          "title": "Config",
          "type": "string"
        },
        "derived": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Derived",
          "type": "object"
        },
        "e2e_means": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "E2E Means",
          "type": "object"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "judge_cost_usd": {
          "title": "Judge Cost Usd",
          "type": "number"
        },
        "latency_p50_s": {
          "title": "Latency P50 S",
          "type": "number"
        },
        "latency_p95_s": {
          "title": "Latency P95 S",
          "type": "number"
        },
        "mean_cost_usd": {
          "title": "Mean Cost Usd",
          "type": "number"
        },
        "mean_tokens": {
          "title": "Mean Tokens",
          "type": "number"
        },
        "pass_at_k": {
          "title": "Pass At K",
          "type": "number"
        },
        "pass_hat_k": {
          "title": "Pass Hat K",
          "type": "number"
        },
        "pass_rate": {
          "title": "Pass Rate",
          "type": "number"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "per_task_pass": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Per Task Pass",
          "type": "object"
        },
        "repeats": {
          "title": "Repeats",
          "type": "integer"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Roles",
          "type": "object"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "step_means": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Step Means",
          "type": "object"
        },
        "tasks": {
          "title": "Tasks",
          "type": "integer"
        },
        "trials": {
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "scenario",
        "pattern",
        "config",
        "roles",
        "trials",
        "tasks",
        "repeats",
        "pass_rate",
        "ci_low",
        "ci_high",
        "pass_hat_k",
        "pass_at_k",
        "errors",
        "mean_tokens",
        "mean_cost_usd",
        "judge_cost_usd",
        "latency_p50_s",
        "latency_p95_s"
      ],
      "title": "ConfigSummary",
      "type": "object"
    },
    "DecisionSummary": {
      "properties": {
        "abstain_rate": {
          "title": "Abstain Rate",
          "type": "number"
        },
        "accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accuracy"
        },
        "brier": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Brier"
        },
        "calibration": {
          "items": {
            "$ref": "#/$defs/CalibrationBin"
          },
          "title": "Calibration",
          "type": "array"
        },
        "config": {
          "title": "Config",
          "type": "string"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "escalation_rate": {
          "title": "Escalation Rate",
          "type": "number"
        },
        "false_alarm_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "noul: P(pred true | label false); approval: unnecessary escalations",
          "title": "False Alarm Rate"
        },
        "human_reviews": {
          "title": "Human Reviews",
          "type": "integer"
        },
        "labeled": {
          "title": "Labeled",
          "type": "integer"
        },
        "latency_p50_s": {
          "title": "Latency P50 S",
          "type": "number"
        },
        "latency_p95_s": {
          "title": "Latency P95 S",
          "type": "number"
        },
        "log_loss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Log Loss"
        },
        "missed_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "noul: P(pred false | label true); approval/review: false-safe",
          "title": "Missed Rate"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "point": {
          "title": "Point",
          "type": "string"
        },
        "policy": {
          "title": "Policy",
          "type": "string"
        },
        "qtype": {
          "title": "Qtype",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "config",
        "policy",
        "point",
        "question",
        "qtype",
        "n",
        "labeled",
        "accuracy",
        "brier",
        "log_loss",
        "missed_rate",
        "false_alarm_rate",
        "escalation_rate",
        "abstain_rate",
        "human_reviews",
        "latency_p50_s",
        "latency_p95_s",
        "cost_usd"
      ],
      "title": "DecisionSummary",
      "type": "object"
    },
    "PairedTest": {
      "properties": {
        "best": {
          "title": "Best",
          "type": "string"
        },
        "difference": {
          "title": "Difference",
          "type": "number"
        },
        "other": {
          "title": "Other",
          "type": "string"
        },
        "p_value": {
          "title": "P Value",
          "type": "number"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "tasks": {
          "title": "Tasks",
          "type": "integer"
        }
      },
      "required": [
        "scenario",
        "best",
        "other",
        "difference",
        "p_value",
        "tasks"
      ],
      "title": "PairedTest",
      "type": "object"
    },
    "ReplacementEffect": {
      "description": "One swapped step against the baseline, on the tasks both ran (replacement studies).",
      "properties": {
        "baseline_rate": {
          "title": "Baseline Rate",
          "type": "number"
        },
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "config": {
          "title": "Config",
          "type": "string"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "delta_cost_usd": {
          "title": "Delta Cost Usd",
          "type": "number"
        },
        "delta_latency_s": {
          "title": "Delta Latency S",
          "type": "number"
        },
        "errors": {
          "default": 0,
          "title": "Errors",
          "type": "integer"
        },
        "p_value": {
          "title": "P Value",
          "type": "number"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "step_deltas": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Step Deltas",
          "type": "object"
        },
        "tasks": {
          "title": "Tasks",
          "type": "integer"
        },
        "variant_rate": {
          "title": "Variant Rate",
          "type": "number"
        }
      },
      "required": [
        "scenario",
        "role",
        "candidate",
        "config",
        "tasks",
        "baseline_rate",
        "variant_rate",
        "delta",
        "p_value",
        "delta_cost_usd",
        "delta_latency_s"
      ],
      "title": "ReplacementEffect",
      "type": "object"
    }
  },
  "description": "Everything the report viewer needs for one run; export/import format between runtimes.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/BundledArtifact"
      },
      "description": "artifact key -> file, for the included traces (exports, browser storage)",
      "title": "Artifacts",
      "type": "object"
    },
    "battles": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Battles",
      "type": "array"
    },
    "decisions": {
      "description": "one row per control decision × question",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Decisions",
      "type": "array"
    },
    "run": {
      "additionalProperties": true,
      "title": "Run",
      "type": "object"
    },
    "scores": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Scores",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/BundleSummary"
    },
    "traces": {
      "additionalProperties": true,
      "description": "trial id -> trace (empty when loaded lazily)",
      "title": "Traces",
      "type": "object"
    },
    "trials": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Trials",
      "type": "array"
    }
  },
  "required": [
    "run",
    "summary",
    "trials",
    "scores",
    "battles"
  ],
  "title": "RunBundle",
  "type": "object"
}
