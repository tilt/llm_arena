        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "needs": {
          "description": "capabilities the bound model must have",
          "items": {
            "type": "string"
          },
          "title": "Needs",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "RoleManifest",
      "type": "object"
    },
    "WikiLink": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "WikiLink",
      "type": "object"
    }
  },
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
